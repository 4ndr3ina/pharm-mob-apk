<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Pharmmobapk" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Pharmmobapk" parent="Base.Theme.Pharmmobapk" />

    <!-- Base style for Detail text to avoid repetition -->
    <style name="TextAppearance.Pharmacy.Detail" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="TextAppearance.Pharmacy.DetailLabel" parent="TextAppearance.Pharmacy.Detail">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/hint_grey</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textStyle">bold</item> <!-- Added for visual hierarchy -->
    </style>

    <style name="TextAppearance.Pharmacy.DetailValue" parent="TextAppearance.Pharmacy.Detail">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>
</resources>