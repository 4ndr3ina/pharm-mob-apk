<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvAndrianiKoui"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:text="Andriani Koui" />

    <EditText
        android:id="@+id/etDoctorName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Doctor Name"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/etDoctorAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Address (City, Street, Number)"
        android:inputType="textPostalAddress"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvGeocodeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@android:color/darker_gray" />

    <Button
        android:id="@+id/btnSaveDoctor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Doctor"
        android:layout_marginTop="24dp" />

</LinearLayout>