<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only needed for the pre-Android-10 file-write fallback in DrugExporter.
         MediaStore (used on API 29+) does not need this permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Needed by android.location.Geocoder (used in AddDoctorActivity) to
         look up coordinates for a typed address. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".DrugManagerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Pharmmobapk"
        tools:ignore="MissingClass">

        <activity
            android:name=".ui.OverviewActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.AddDrugActivity" android:exported="false" />
        <activity android:name=".ui.AddDoctorActivity" android:exported="false" />
        <activity android:name=".ui.DeleteDrugActivity" android:exported="false" />
        <activity android:name=".ui.DrugDetailActivity" android:exported="false" />
        <activity android:name=".ui.AllPrescriptionsActivity" android:exported="false" />

        <provider
            android:name=".provider.DrugContentProvider"
            android:authorities="gr.hua.dit.moddrugmanager.provider"
            android:exported="true" />

    </application>
</manifest>